# Copy to backend/.env and fill in. The app refuses to start without the four REQUIRED values.

# Product name shown on emails and in the API docs (the frontend uses NEXT_PUBLIC_APP_NAME).
APP_NAME=ImoSmart

# --- REQUIRED ---
# AUTH_SECRET (32+ chars): python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECRET=
# Comma-separated list of frontend origins, no wildcard, no trailing slash
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://scholarpulse:change-me@localhost:5432/scholarpulse
# Public URL of the frontend (used in email links)
APP_URL=http://localhost:3000

# --- AI (set at least one; Gemini is used first, Groq is the fallback) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_MAX_OUTPUT_TOKENS=4096

# --- Paper sources (optional keys, they raise rate limits) ---
CORE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# PubMed works without a key (3 requests/second); a free NCBI key raises it to 10.
NCBI_API_KEY=
# Contact email NCBI asks API users to send. Empty falls back to CONTACT_EMAIL / SMTP_FROM_EMAIL.
NCBI_EMAIL=
# Europe PMC needs no key.
# Unpaywall (free PDF links) needs only a contact email: NCBI_EMAIL or CONTACT_EMAIL. Set to false to turn it off.
UNPAYWALL_ENABLED=true

# --- Email over SMTP (Brevo shown). SMTP_FROM_EMAIL must be a sender verified with your provider.
# If left empty it defaults to noreply@<host of APP_URL>. ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Sender name on emails. Defaults to APP_NAME when empty.
# SMTP_FROM_NAME=
# Contact address sent to the paper APIs (their "polite pool"). Defaults to SMTP_FROM_EMAIL.
CONTACT_EMAIL=

# --- Cookies and environment ---
# Local development: DEV_MODE=true (cookie defaults to non-Secure, emails are printed to the console, /docs is on).
# Production: DEV_MODE=false (cookie is Secure by default; only set COOKIE_SECURE if you must override it).
DEV_MODE=false
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Leave empty unless frontend and API live on different subdomains (e.g. .example.com)
COOKIE_DOMAIN=

# --- API surface ---
# When nginx serves the API under a prefix and strips it (location /api/ -> proxy_pass .../), set the prefix here
# so the interactive docs call the right URLs. Leave empty if the API is served at the domain root.
API_ROOT_PATH=
# Serve /docs and /openapi.json (default: only when DEV_MODE=true; uncomment to force on/off)
# ENABLE_DOCS=false
# Max request body in bytes
MAX_BODY_BYTES=1000000
# Set false to skip downloading/running the local embedding model used for re-ranking
ENABLE_RERANKING=true

# --- Sessions and abuse protection (0 disables a limit) ---
# How long a sign-in lasts (days). Logout revokes the session on the server immediately.
SESSION_DAYS=14
# Per-ACCOUNT lockout: this many failed sign-ins within the window locks that account until the window ends.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
# Verification / reset / notice emails one address can receive per hour
EMAIL_MAX_PER_HOUR=3
VERIFICATION_TOKEN_HOURS=48
# Daily AI-call caps per UTC day: AI calls cost money. Guests are counted per IP, accounts per user, plus a total.
AI_DAILY_LIMIT_GUEST=30
AI_DAILY_LIMIT_USER=200
AI_DAILY_LIMIT_GLOBAL=3000
# Deep research runs per UTC day (each run is 2 AI calls and also counts toward the caps above).
DEEP_DAILY_LIMIT_GUEST=3
DEEP_DAILY_LIMIT_USER=20
DEEP_DAILY_LIMIT_GLOBAL=300

# --- Cache and proxy ---
# Redis is optional: without it an in-memory cache is used
REDIS_URL=redis://127.0.0.1:6379/0
# Number of reverse proxies (nginx, Caddy, ...) in front of the API that append X-Forwarded-For.
# 0 = ignore the header entirely. Use 1 when exactly one proxy sits in front.
TRUSTED_PROXY_COUNT=0

# --- Admin panel ---
# Required for the admin area: encrypts admin authenticator secrets and API keys saved in the panel.
# Create one with:  python make_admin.py new-encryption-key
# Keep it secret and back it up: without it, keys saved in the panel cannot be read (the .env keys still work).
SETTINGS_ENCRYPTION_KEY=
# Minutes an unlocked admin session lasts.
ADMIN_SESSION_MINUTES=30

# --- PDF uploads ---
# Only the extracted text is stored; the PDF itself is discarded. nginx must allow bodies this large on /api/
# (client_max_body_size), otherwise uploads stop at nginx's limit.
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=300
MAX_DOCUMENTS_PER_USER=50
MAX_UPLOADS_PER_DAY=20

# --- Housekeeping (runs once a day inside the API) ---
# Guest history (no account) older than this many days is deleted. Account history is kept until the user deletes it.
GUEST_HISTORY_DAYS=90
# Admin audit log entries older than this many days are deleted.
AUDIT_LOG_DAYS=365
HOUSEKEEPING_ENABLED=true
# Folder where scripts/backup-db.sh writes backups; the admin Overview reads it (read-only) to show backup status.
BACKUP_DIR=~/backups/imosmart
