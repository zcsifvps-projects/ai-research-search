# Baked into the build by Next.js: set them BEFORE `npm run build` (Docker: build args).
# For local development use "localhost" for both, not 127.0.0.1, so the login cookie is sent.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Content-Security-Policy for production builds: enforce (default) | report-only | off
# Tip: build once with CSP_MODE=report-only, click through the app with the browser console open, and switch to enforce
# when no violations are reported.
# CSP_MODE=enforce
